<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1920, height=1080" />
    <!-- Generated by build.py from index.template.tpl. Edit index.template.tpl, then run: python build.py -->
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/gsap.min.js"></script>
    <style>
      @font-face { font-family: "Segoe UI"; src: local("Segoe UI"); font-weight: 400; }
      @font-face { font-family: "Segoe UI Semibold"; src: local("Segoe UI Semibold"); font-weight: 600; }
      :root {
        --ground: #8c0f2e;
        --ink: #ffffff;
        --accent: #ffc94d;
        --font-display: "Segoe UI Semibold", "Segoe UI", sans-serif;
        --font-body: "Segoe UI", sans-serif;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 1920px; height: 1080px; overflow: hidden; background: var(--ground); }
      #root { position: relative; width: 1920px; height: 1080px; overflow: hidden; background: var(--ground); font-family: var(--font-body); color: var(--ink); }

      #stage { position: absolute; left: 0; top: 0; width: 22000px; height: 1080px; transform-origin: 0 0; opacity: 0; }
      .win { position: absolute; top: 0; width: 1920px; height: 1080px; background: #fff; border-radius: 14px; overflow: hidden; box-shadow: 0 40px 80px rgba(0, 0, 0, 0.35); }
      .win img { display: block; width: 1920px; height: 1080px; }

      .hl { position: absolute; overflow: visible; pointer-events: none; opacity: 0; }
      .hl rect { fill: none; stroke: var(--accent); stroke-width: 6; stroke-linecap: round; }
      #cursor { position: absolute; left: 0; top: 0; width: 44px; height: 44px; opacity: 0; }
      #cursor .ring { position: absolute; left: -26px; top: -26px; width: 52px; height: 52px; border-radius: 50%; border: 5px solid var(--accent); opacity: 0; }

      .chip { position: absolute; left: 96px; bottom: 64px; padding: 14px 26px; border-radius: 12px; background: var(--ground); color: var(--ink); font: 600 30px var(--font-display); box-shadow: 0 16px 36px rgba(0, 0, 0, 0.35); opacity: 0; }

      .card { opacity: 0; }
      .kicker { position: absolute; left: 164px; top: 200px; font: 400 34px var(--font-body); opacity: 0.85; }
      .line { position: absolute; left: 160px; font: 600 104px/1.1 var(--font-display); letter-spacing: -0.015em; white-space: nowrap; }
      .line em { font-style: normal; color: var(--accent); }
      #t1 { top: 290px; }
      #t2 { top: 410px; }
      #tsub { position: absolute; left: 164px; top: 600px; width: 820px; font: 400 36px/1.35 var(--font-body); opacity: 0.85; }
      #steps { position: absolute; left: 1180px; top: 250px; list-style: none; }
      #steps li { font: 400 34px/1 var(--font-body); margin-bottom: 30px; opacity: 0; display: flex; align-items: center; }
      #steps li b { display: inline-block; width: 52px; height: 52px; margin-right: 22px; border-radius: 50%; border: 3px solid var(--accent); color: var(--accent); font: 600 28px/46px var(--font-display); text-align: center; }
      #e1 { top: 330px; }
      #e2 { top: 450px; }
      #note { position: absolute; right: 96px; top: 64px; width: 620px; padding: 22px 28px; border-radius: 14px; background: var(--accent); color: #2a0610; font: 600 32px/1.3 var(--font-display); box-shadow: 0 16px 36px rgba(0, 0, 0, 0.35); opacity: 0; }
      #note span { display: block; font: 400 26px/1.35 var(--font-body); margin-top: 6px; }
      #esub { position: absolute; left: 164px; top: 640px; font: 400 34px var(--font-body); opacity: 0.85; }
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="main" data-start="0" data-duration="{{TOTAL}}" data-width="1920" data-height="1080">
      <div id="stage" class="clip" data-start="0" data-duration="{{TOTAL}}" data-track-index="0">
        <div class="win" style="left:0"><img src="assets/shots/01-settings.png" alt="" /></div>
        <div class="win" style="left:2000px"><img src="assets/shots/02-groups.png" alt="" /></div>
        <div class="win" style="left:4000px"><img src="assets/shots/03-rules.png" alt="" /></div>
        <div class="win" style="left:6000px"><img src="assets/shots/04-connectors.png" alt="" /></div>
        <div class="win" style="left:8000px"><img src="assets/shots/05-outlook.png" alt="" /></div>
        <div class="win" style="left:10000px"><img src="assets/shots/06-actions.png" alt="" /></div>
        <div class="win" style="left:12000px"><img src="assets/shots/07-catalog.png" alt="" /></div>
        <div class="win" style="left:14000px"><img src="assets/shots/08-sharing.png" alt="" /></div>
        <div class="win" style="left:16000px"><img src="assets/shots/09-csp.png" alt="" /></div>
        <div class="win" style="left:18000px"><img src="assets/shots/10-all-apps.png" alt="" /></div>
        <div class="win" style="left:20000px"><img src="assets/shots/11-app-connectors.png" alt="" /></div>
        <div id="hls"></div>
        <div id="cursor">
          <div class="ring"></div>
          <svg width="44" height="44" viewBox="0 0 24 24"><path d="M3 2l7.5 19 2.6-7.4L20.5 11z" fill="#111" stroke="#fff" stroke-width="1.6" stroke-linejoin="round" /></svg>
        </div>
      </div>

      <div id="intro" class="clip" data-start="{{S0}}" data-duration="{{D0}}" data-track-index="1">
        <div id="ik" class="kicker card">Copilot Managed Runtime lab · Exercise 1, steps 7b and 7c</div>
        <div id="t1" class="line card">What can your</div>
        <div id="t2" class="line card">apps <em>touch?</em></div>
        <div id="tsub" class="card">A tour of the app controls in the Microsoft 365 admin center.</div>
        <ol id="steps">
          <li><b>1</b>Environment groups</li>
          <li><b>2</b>Connectors and MCP servers</li>
          <li><b>3</b>Connector actions</li>
          <li><b>4</b>Sharing</li>
          <li><b>5</b>Content security policy</li>
          <li><b>6</b>All apps</li>
        </ol>
      </div>

{{CHIPS}}

      <div id="note" class="clip" data-start="{{NS}}" data-duration="{{ND}}" data-track-index="3">Policy changes take time.<span>It can take several minutes, sometimes much longer, before running apps see a change.</span></div>

      <div id="outro" class="clip" data-start="{{S12}}" data-duration="{{D12}}" data-track-index="1">
        <div id="e1" class="line card">Your apps follow your rules.</div>
        <div id="e2" class="line card">Now <em>check yours.</em></div>
        <div id="esub" class="card">Copilot Managed Runtime lab · Exercise 1, steps 7b and 7c</div>
      </div>

{{AUDIO}}
    </div>
    <script>
      // Scene starts (s), written by build.py; each voice clip begins 0.3 s after its scene.
      const S = {{S}};
      const V = (i, t) => S[i] + 0.3 + t;

      // Screenshots are 1600x900, shown at 1.2x; shot k sits at stage x = k * 2000.
      const P = (k, x, y) => [k * 2000 + x * 1.2, y * 1.2];

      // Highlights in screenshot coordinates: [shot, x, y, w, h].
      const HL = {
        h0a: [0, 30, 386, 100, 28],
        h0b: [0, 330, 384, 1206, 38],
        h1a: [1, 330, 392, 1206, 58],
        h2a: [2, 328, 248, 1210, 210],
        h2b: [2, 1150, 248, 122, 210],
        h2c: [2, 328, 322, 1210, 44],
        h3a: [3, 680, 168, 436, 24],
        h3b: [3, 1006, 256, 146, 562],
        h4a: [4, 1334, 202, 244, 38],
        h4b: [4, 688, 288, 888, 44],
        h4c: [4, 848, 206, 116, 30],
        h5a: [5, 688, 238, 872, 44],
        h5b: [5, 688, 286, 872, 44],
        h5c: [5, 688, 778, 872, 34],
        h5d: [5, 786, 842, 102, 36],
        h6a: [6, 683, 98, 472, 36],
        h6b: [6, 688, 236, 886, 48],
        h6c: [6, 744, 842, 100, 36],
        h7a: [7, 683, 94, 895, 118],
        h7b: [7, 683, 282, 424, 84],
        h7c: [7, 683, 410, 356, 30],
        h7d: [7, 1430, 109, 136, 36],
        h8a: [8, 683, 94, 880, 118],
        h8b: [8, 683, 454, 884, 64],
        h8c: [8, 683, 533, 184, 284],
        h9a: [9, 30, 322, 90, 28],
        h9b: [9, 328, 740, 1210, 156],
        h10a: [10, 916, 178, 94, 40],
        h10b: [10, 726, 396, 810, 72],
        h10c: [10, 1454, 106, 100, 36],
      };
      const hls = document.getElementById("hls");
      for (const [id, [k, x, y, w0, h0]] of Object.entries(HL)) {
        const [sx, sy] = P(k, x, y);
        const w = w0 * 1.2, h = h0 * 1.2;
        hls.insertAdjacentHTML(
          "beforeend",
          `<svg class="hl" id="${id}" style="left:${sx}px;top:${sy}px" width="${w}" height="${h}" viewBox="0 0 ${w} ${h}"><rect x="3" y="3" width="${w - 6}" height="${h - 6}" rx="12" pathLength="1" stroke-dasharray="1" stroke-dashoffset="1"/></svg>`
        );
      }

      const tl = gsap.timeline({ paused: true });
      const stage = "#stage";
      gsap.set(stage, { transformOrigin: "0 0" });
      // The camera centre is clamped so a zoomed view never shows past the screenshot edges.
      const clamp = (v, lo, hi) => Math.min(Math.max(v, lo), hi);
      const camSet = (k, x, y, s) => {
        const [cx, cy] = P(k, clamp(x, 800 / s, 1600 - 800 / s), clamp(y, 450 / s, 900 - 450 / s));
        return { x: 960 - cx * s, y: 540 - cy * s, scale: s };
      };
      const cam = (t, k, x, y, s, d, ease = "power2.inOut") => tl.to(stage, { ...camSet(k, x, y, s), duration: d, ease }, t);
      const full = (t, k, d = 1.1) => cam(t, k, 800, 450, 1, d);
      const draw = (id, t, hold) => {
        tl.fromTo(`#${id} rect`, { attr: { "stroke-dashoffset": 1 } }, { attr: { "stroke-dashoffset": 0 }, duration: 0.5, ease: "power2.out" }, t);
        tl.set(`#${id}`, { opacity: 1 }, t);
        tl.to(`#${id}`, { opacity: 0, duration: 0.3 }, t + hold);
      };
      const clickAt = (t, k, x, y, from = [-140, 120]) => {
        const [px, py] = P(k, x, y);
        tl.set("#cursor", { x: px + from[0], y: py + from[1] }, t);
        tl.to("#cursor", { opacity: 1, duration: 0.2 }, t);
        tl.to("#cursor", { x: px, y: py, duration: 0.7, ease: "power3.inOut" }, t + 0.05);
        const c = t + 0.9;
        tl.to("#cursor svg", { scale: 0.8, duration: 0.06, transformOrigin: "3px 2px" }, c);
        tl.to("#cursor svg", { scale: 1, duration: 0.1 }, c + 0.06);
        tl.fromTo("#cursor .ring", { scale: 0.4, opacity: 1 }, { scale: 1.6, opacity: 0, duration: 0.45, ease: "power2.out" }, c);
        tl.to("#cursor", { opacity: 0, duration: 0.2 }, c + 0.5);
      };
      const chip = (i) => tl.fromTo(`#chip${String(i).padStart(2, "0")}`, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.35, ease: "power3.out" }, S[i] + 0.5);

      tl.set(stage, camSet(0, 800, 450, 1), 0);

      // 0. Intro card.
      tl.fromTo("#ik", { opacity: 0 }, { opacity: 0.85, duration: 0.5 }, 0.3);
      tl.fromTo("#t1", { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.5, ease: "power3.out" }, 0.6);
      tl.fromTo("#t2", { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.5, ease: "power3.out" }, 1.0);
      tl.fromTo("#tsub", { opacity: 0 }, { opacity: 0.85, duration: 0.5 }, V(0, 4.2));
      document.querySelectorAll("#steps li").forEach((li, n) => {
        tl.fromTo(li, { opacity: 0, x: 40 }, { opacity: 1, x: 0, duration: 0.4, ease: "power3.out" }, V(0, 8.6 + n * 0.45));
      });
      tl.to("#intro", { opacity: 0, duration: 0.4 }, S[1] - 0.4);
      tl.fromTo(stage, { opacity: 0 }, { opacity: 1, duration: 0.5 }, S[1] - 0.1);

      // 1. Apps > Settings > Environment groups.
      chip(1);
      cam(S[1] + 0.4, 0, 760, 360, 1.3, 1.0);
      draw("h0a", V(1, 0.6), 1.8);
      draw("h0b", V(1, 2.6), 2.6);
      clickAt(V(1, 3.6), 0, 460, 403);

      // 2. Environment groups list.
      full(S[2], 1);
      chip(2);
      cam(S[2] + 1.1, 1, 800, 380, 1.35, 1.2);
      draw("h1a", V(2, 2.0), 5.4);
      clickAt(V(2, 8.6), 1, 470, 412);

      // 3. Default group rules and Managed by.
      full(S[3], 2);
      chip(3);
      cam(S[3] + 1.1, 2, 930, 360, 1.3, 1.2);
      draw("h2a", V(3, 0.6), 5.6);
      draw("h2b", V(3, 7.0), 4.4);
      draw("h2c", V(3, 13.8), 5.6);

      // 4. Connectors and MCP servers panel.
      full(S[4], 3);
      chip(4);
      cam(S[4] + 1.1, 3, 1130, 480, 1.25, 1.2);
      draw("h3a", V(4, 3.0), 4.6);
      draw("h3b", V(4, 9.4), 7.6);

      // 5. Office 365 Outlook > Edit actions.
      cam(S[5], 4, 1130, 260, 1.4, 1.2);
      chip(5);
      draw("h4a", V(5, 1.4), 1.6);
      draw("h4b", V(5, 3.0), 1.6);
      draw("h4c", V(5, 4.6), 2.2);
      clickAt(V(5, 4.9), 4, 906, 221, [-120, 140]);

      // 6. One switch per action.
      full(S[6], 5);
      chip(6);
      cam(S[6] + 1.1, 5, 1120, 400, 1.3, 1.2);
      draw("h5a", V(6, 3.0), 1.6);
      draw("h5b", V(6, 4.3), 1.8);
      cam(V(6, 5.4), 5, 1120, 600, 1.3, 1.0);
      draw("h5c", V(6, 6.0), 2.8);
      tl.to("#chip06", { opacity: 0, y: 20, duration: 0.3, ease: "power2.in" }, V(6, 16.9));
      draw("h5d", V(6, 17.4), 2.6);
      clickAt(V(6, 17.6), 5, 836, 860, [-140, -120]);

      // 7. Connector catalog, then the propagation note.
      full(S[7], 6);
      chip(7);
      cam(S[7] + 1.1, 6, 1000, 300, 1.35, 1.2);
      draw("h6a", V(7, 4.6), 2.0);
      draw("h6b", V(7, 6.4), 2.0);
      cam(V(7, 7.6), 6, 900, 650, 1.25, 1.0);
      draw("h6c", V(7, 8.0), 2.2);
      tl.fromTo("#note", { opacity: 0, y: -20 }, { opacity: 1, y: 0, duration: 0.4, ease: "power3.out" }, V(7, 10.4) + 0.05);

      // 8. Sharing.
      full(S[8], 7);
      chip(8);
      cam(S[8] + 1.1, 7, 1130, 260, 1.35, 1.2);
      draw("h7b", V(8, 3.6), 4.6);
      draw("h7c", V(8, 9.4), 2.4);
      draw("h7d", V(8, 12.0), 2.4);
      draw("h7a", V(8, 14.0), 3.0);

      // 9. Content security policy.
      full(S[9], 8);
      chip(9);
      cam(S[9] + 1.1, 8, 1120, 380, 1.3, 1.2);
      draw("h8b", V(9, 4.0), 3.6);
      cam(V(9, 7.4), 8, 1000, 600, 1.3, 1.0);
      draw("h8c", V(9, 8.0), 7.0);

      // 10. All apps inventory.
      full(S[10], 9);
      chip(10);
      draw("h9a", V(10, 0.9), 2.2);
      cam(V(10, 3.0), 9, 900, 700, 1.2, 1.2);
      draw("h9b", V(10, 4.2), 6.0);

      // 11. App details > Connectors, and Block.
      full(S[11], 10);
      chip(11);
      cam(S[11] + 1.1, 10, 1130, 300, 1.35, 1.2);
      clickAt(V(11, 1.0), 10, 963, 196, [-140, 120]);
      draw("h10a", V(11, 2.0), 2.2);
      draw("h10b", V(11, 4.6), 5.2);
      draw("h10c", V(11, 11.0), 4.6);

      // 12. End card.
      tl.to(stage, { opacity: 0, duration: 0.5 }, S[12]);
      tl.fromTo("#e1", { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.45, ease: "power3.out" }, S[12] + 0.3);
      tl.fromTo("#e2", { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.45, ease: "power3.out" }, V(12, 1.6));
      tl.fromTo("#esub", { opacity: 0 }, { opacity: 0.85, duration: 0.5 }, V(12, 2.8));
      tl.set({}, {}, {{TOTAL}});

      window.__timelines["main"] = tl;
      tl.seek(0);
    </script>
  </body>
</html>
