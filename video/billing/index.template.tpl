<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1920, height=1080" />
    <!-- Generated by build.py from template.html. Edit index.template.tpl, then run: python build.py -->
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/gsap.min.js"></script>
    <style>
      @font-face { font-family: "Segoe UI"; src: local("Segoe UI"); font-weight: 400; }
      @font-face { font-family: "Segoe UI Semibold"; src: local("Segoe UI Semibold"); font-weight: 600; }
      :root {
        --ground: #8c0f2e;
        --ink: #ffffff;
        --accent: #ffc94d;
        --font-display: "Segoe UI Semibold", "Segoe UI", sans-serif;
        --font-body: "Segoe UI", sans-serif;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 1920px; height: 1080px; overflow: hidden; background: var(--ground); }
      #root { position: relative; width: 1920px; height: 1080px; overflow: hidden; background: var(--ground); font-family: var(--font-body); color: var(--ink); }

      #stage { position: absolute; left: 0; top: 0; width: 22000px; height: 1080px; transform-origin: 0 0; opacity: 0; }
      .win { position: absolute; top: 0; width: 1920px; height: 1080px; background: #fff; border-radius: 14px; overflow: hidden; box-shadow: 0 40px 80px rgba(0, 0, 0, 0.35); }
      .win img { display: block; width: 1920px; height: 1080px; }

      .hl { position: absolute; overflow: visible; pointer-events: none; opacity: 0; }
      .hl rect { fill: none; stroke: var(--accent); stroke-width: 6; stroke-linecap: round; }
      #cursor { position: absolute; left: 0; top: 0; width: 44px; height: 44px; opacity: 0; }
      #cursor .ring { position: absolute; left: -26px; top: -26px; width: 52px; height: 52px; border-radius: 50%; border: 5px solid var(--accent); opacity: 0; }

      .chip { position: absolute; left: 96px; bottom: 64px; padding: 14px 26px; border-radius: 12px; background: var(--ground); color: var(--ink); font: 600 30px var(--font-display); box-shadow: 0 16px 36px rgba(0, 0, 0, 0.35); opacity: 0; }

      .card { opacity: 0; }
      .kicker { position: absolute; left: 164px; top: 200px; font: 400 34px var(--font-body); opacity: 0.85; }
      .line { position: absolute; left: 160px; font: 600 104px/1.1 var(--font-display); letter-spacing: -0.015em; white-space: nowrap; }
      .line em { font-style: normal; color: var(--accent); }
      #t1 { top: 290px; }
      #t2 { top: 410px; }
      #tsub { position: absolute; left: 164px; top: 600px; width: 820px; font: 400 36px/1.35 var(--font-body); opacity: 0.85; }
      #steps { position: absolute; left: 1180px; top: 250px; list-style: none; }
      #steps li { font: 400 34px/1 var(--font-body); margin-bottom: 30px; opacity: 0; display: flex; align-items: center; }
      #steps li b { display: inline-block; width: 52px; height: 52px; margin-right: 22px; border-radius: 50%; border: 3px solid var(--accent); color: var(--accent); font: 600 28px/46px var(--font-display); text-align: center; }
      #e1 { top: 330px; }
      #e2 { top: 450px; }
      #esub { position: absolute; left: 164px; top: 640px; font: 400 34px var(--font-body); opacity: 0.85; }
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="main" data-start="0" data-duration="{{TOTAL}}" data-width="1920" data-height="1080">
      <div id="stage" class="clip" data-start="0" data-duration="{{TOTAL}}" data-track-index="0">
        <div class="win" style="left:0"><img src="assets/shots/01-cost-management.png" alt="" /></div>
        <div class="win" style="left:2000px"><img src="assets/shots/02-configuration.png" alt="" /></div>
        <div class="win" style="left:4000px"><img src="assets/shots/03-scope.png" alt="" /></div>
        <div class="win" style="left:6000px"><img src="assets/shots/04-services.png" alt="" /></div>
        <div class="win" style="left:8000px"><img src="assets/shots/05-policy-limit.png" alt="" /></div>
        <div class="win" style="left:10000px"><img src="assets/shots/06-user-limit.png" alt="" /></div>
        <div class="win" style="left:12000px"><img src="assets/shots/07-model.png" alt="" /></div>
        <div class="win" style="left:14000px"><img src="assets/shots/08-billing-method.png" alt="" /></div>
        <div class="win" style="left:16000px"><img src="assets/shots/09-review.png" alt="" /></div>
        <div class="win" style="left:18000px"><img src="assets/shots/10-created.png" alt="" /></div>
        <div id="hls"></div>
        <div id="cursor">
          <div class="ring"></div>
          <svg width="44" height="44" viewBox="0 0 24 24"><path d="M3 2l7.5 19 2.6-7.4L20.5 11z" fill="#111" stroke="#fff" stroke-width="1.6" stroke-linejoin="round" /></svg>
        </div>
      </div>

      <div id="intro" class="clip" data-start="{{S0}}" data-duration="{{D0}}" data-track-index="1">
        <div id="ik" class="kicker card">Copilot Managed Runtime lab · Exercise 1, step 7a</div>
        <div id="t1" class="line card">Who <em>pays</em> when</div>
        <div id="t2" class="line card">your app runs?</div>
        <div id="tsub" class="card">Set up a spending policy in the Microsoft 365 admin center.</div>
        <ol id="steps">
          <li><b>1</b>Policy scope</li>
          <li><b>2</b>Agents and services</li>
          <li><b>3</b>Limits and alerts</li>
          <li><b>4</b>Model template</li>
          <li><b>5</b>Billing method</li>
          <li><b>6</b>Review and add policy</li>
        </ol>
      </div>

{{CHIPS}}

      <div id="outro" class="clip" data-start="{{S11}}" data-duration="{{D11}}" data-track-index="1">
        <div id="e1" class="line card">Your apps have a budget.</div>
        <div id="e2" class="line card">Now <em>create yours.</em></div>
        <div id="esub" class="card">Copilot Managed Runtime lab · Exercise 1, step 7a</div>
      </div>

{{AUDIO}}
    </div>
    <script>
      // Scene starts (s), written by build.py; each voice clip begins 0.3 s after its scene.
      const S = {{S}};
      const V = (i, t) => S[i] + 0.3 + t;

      // Screenshots are 1600x900, shown at 1.2x; shot k sits at stage x = k * 2000.
      const P = (k, x, y) => [k * 2000 + x * 1.2, y * 1.2];

      // Highlights in screenshot coordinates: [shot, x, y, w, h].
      const HL = {
        h0a: [0, 10, 174, 270, 30],
        h0b: [0, 24, 432, 172, 32],
        h1a: [1, 410, 278, 116, 42],
        h1b: [1, 326, 566, 1214, 116],
        h2a: [2, 512, 278, 298, 44],
        h2b: [2, 520, 438, 496, 110],
        h3a: [3, 562, 492, 668, 54],
        h4a: [4, 520, 324, 210, 44],
        h4b: [4, 548, 486, 298, 48],
        h4c: [4, 548, 554, 798, 46],
        h5a: [5, 520, 462, 260, 44],
        h5b: [5, 548, 518, 298, 48],
        h5c: [5, 520, 680, 162, 42],
        h6a: [6, 520, 274, 290, 48],
        h7a: [7, 502, 252, 872, 110],
        h8a: [8, 518, 710, 840, 128],
        h9a: [9, 326, 422, 1214, 40],
        h9b: [9, 326, 724, 1214, 70],
        h9c: [9, 322, 388, 1140, 30],
      };
      const hls = document.getElementById("hls");
      for (const [id, [k, x, y, w0, h0]] of Object.entries(HL)) {
        const [sx, sy] = P(k, x, y);
        const w = w0 * 1.2, h = h0 * 1.2;
        hls.insertAdjacentHTML(
          "beforeend",
          `<svg class="hl" id="${id}" style="left:${sx}px;top:${sy}px" width="${w}" height="${h}" viewBox="0 0 ${w} ${h}"><rect x="3" y="3" width="${w - 6}" height="${h - 6}" rx="12" pathLength="1" stroke-dasharray="1" stroke-dashoffset="1"/></svg>`
        );
      }

      const tl = gsap.timeline({ paused: true });
      const stage = "#stage";
      gsap.set(stage, { transformOrigin: "0 0" });
      const camSet = (k, x, y, s) => { const [cx, cy] = P(k, x, y); return { x: 960 - cx * s, y: 540 - cy * s, scale: s }; };
      const cam = (t, k, x, y, s, d, ease = "power2.inOut") => tl.to(stage, { ...camSet(k, x, y, s), duration: d, ease }, t);
      const full = (t, k, d = 1.1) => cam(t, k, 800, 450, 1, d);
      const draw = (id, t, hold) => {
        tl.fromTo(`#${id} rect`, { attr: { "stroke-dashoffset": 1 } }, { attr: { "stroke-dashoffset": 0 }, duration: 0.5, ease: "power2.out" }, t);
        tl.set(`#${id}`, { opacity: 1 }, t);
        tl.to(`#${id}`, { opacity: 0, duration: 0.3 }, t + hold);
      };
      const clickAt = (t, k, x, y, from = [-140, 120]) => {
        const [px, py] = P(k, x, y);
        tl.set("#cursor", { x: px + from[0], y: py + from[1] }, t);
        tl.to("#cursor", { opacity: 1, duration: 0.2 }, t);
        tl.to("#cursor", { x: px, y: py, duration: 0.7, ease: "power3.inOut" }, t + 0.05);
        const c = t + 0.9;
        tl.to("#cursor svg", { scale: 0.8, duration: 0.06, transformOrigin: "3px 2px" }, c);
        tl.to("#cursor svg", { scale: 1, duration: 0.1 }, c + 0.06);
        tl.fromTo("#cursor .ring", { scale: 0.4, opacity: 1 }, { scale: 1.6, opacity: 0, duration: 0.45, ease: "power2.out" }, c);
        tl.to("#cursor", { opacity: 0, duration: 0.2 }, c + 0.5);
      };
      const chip = (i) => tl.fromTo(`#chip${String(i).padStart(2, "0")}`, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.35, ease: "power3.out" }, S[i] + 0.5);

      // Stage scale 1 shows one screenshot full frame; larger values push in.
      tl.set(stage, camSet(0, 800, 450, 1), 0);

      // 0. Intro card.
      tl.fromTo("#ik", { opacity: 0 }, { opacity: 0.85, duration: 0.5 }, 0.3);
      tl.fromTo("#t1", { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.5, ease: "power3.out" }, 0.6);
      tl.fromTo("#t2", { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.5, ease: "power3.out" }, 1.0);
      tl.fromTo("#tsub", { opacity: 0 }, { opacity: 0.85, duration: 0.5 }, V(0, 6.6));
      document.querySelectorAll("#steps li").forEach((li, n) => {
        tl.fromTo(li, { opacity: 0, x: 40 }, { opacity: 1, x: 0, duration: 0.4, ease: "power3.out" }, V(0, 10.6 + n * 0.32));
      });
      tl.to("#intro", { opacity: 0, duration: 0.4 }, S[1] - 0.4);
      tl.fromTo(stage, { opacity: 0 }, { opacity: 1, duration: 0.5 }, S[1] - 0.1);

      // 1. Copilot > Cost management.
      chip(1);
      cam(V(1, 5.0), 0, 540, 340, 1.5, 1.4);
      draw("h0a", V(1, 6.4), 1.6);
      draw("h0b", V(1, 8.2), 2.4);

      // 2. Configuration > Add spending policy.
      full(S[2], 1);
      chip(2);
      cam(S[2] + 1.1, 1, 760, 430, 1.35, 1.2);
      draw("h1a", V(2, 0.9), 1.6);
      draw("h1b", V(2, 2.6), 2.4);
      clickAt(V(2, 5.2), 1, 430, 536);

      // 3. Policy scope.
      full(S[3], 2);
      chip(3);
      cam(S[3] + 1.1, 2, 760, 420, 1.45, 1.2);
      draw("h2a", V(3, 1.0), 1.8);
      draw("h2b", V(3, 3.0), 3.2);
      cam(V(3, 6.3), 2, 800, 525, 1.2, 0.9);
      clickAt(V(3, 6.9), 2, 532, 868, [-120, -160]);

      // 4. Agents and services: Copilot Managed Runtime.
      full(S[4], 3);
      chip(4);
      cam(S[4] + 1.1, 3, 880, 470, 1.6, 1.2);
      draw("h3a", V(4, 1.6), 4.4);
      cam(V(4, 6.1), 3, 800, 525, 1.2, 0.9);
      clickAt(V(4, 6.7), 3, 624, 868, [-120, -160]);

      // 5. Policy spending limit (arrive zoomed in: the per-user field below is mid-edit).
      cam(S[5], 4, 900, 440, 1.55, 1.3);
      chip(5);
      draw("h4a", V(5, 1.2), 2.1);
      draw("h4b", V(5, 3.6), 2.6);
      draw("h4c", V(5, 6.4), 3.6);

      // 6. Per-user limit, alerts, Next.
      cam(S[6], 5, 900, 520, 1.5, 1.2);
      chip(6);
      draw("h5a", V(6, 1.6), 2.4);
      draw("h5b", V(6, 4.6), 3.0);
      draw("h5c", V(6, 8.2), 1.8);
      cam(V(6, 9.3), 5, 800, 525, 1.2, 0.9);
      clickAt(V(6, 9.9), 5, 624, 868, [-120, -160]);

      // 7. Model template.
      cam(S[7], 6, 760, 420, 1.5, 1.2);
      chip(7);
      draw("h6a", V(7, 0.9), 2.4);
      cam(V(7, 3.3), 6, 800, 525, 1.2, 0.8);
      clickAt(V(7, 3.7), 6, 624, 868, [-120, -160]);

      // 8. Billing method (the subscription is masked in the screenshot).
      cam(S[8], 7, 940, 340, 1.45, 1.2);
      chip(8);
      draw("h7a", V(8, 0.9), 4.6);
      cam(V(8, 5.6), 7, 800, 525, 1.2, 0.8);
      clickAt(V(8, 6.0), 7, 624, 868, [-120, -160]);

      // 9. Review, then Create spending policy.
      cam(S[9], 8, 830, 505, 1.15, 1.2);
      chip(9);
      draw("h8a", V(9, 0.4), 2.0);
      clickAt(V(9, 2.0), 8, 683, 868, [-150, -170]);

      // 10. Created.
      full(S[10] - 0.1, 9, 1.0);
      chip(10);
      cam(S[10] + 1.0, 9, 930, 525, 1.2, 1.2);
      draw("h9a", V(10, 0.6), 1.6);
      draw("h9b", V(10, 2.0), 2.0);
      draw("h9c", V(10, 4.4), 4.0);

      // 11. End card.
      tl.to(stage, { opacity: 0, duration: 0.5 }, S[11]);
      tl.fromTo("#e1", { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.45, ease: "power3.out" }, S[11] + 0.3);
      tl.fromTo("#e2", { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.45, ease: "power3.out" }, V(11, 1.9));
      tl.fromTo("#esub", { opacity: 0 }, { opacity: 0.85, duration: 0.5 }, V(11, 3.0));
      tl.set({}, {}, {{TOTAL}});

      window.__timelines["main"] = tl;
      tl.seek(0);
    </script>
  </body>
</html>
